{
  "name": "veb-prilozhenie",
  "version": "1.4.1",
  "description": "Личное приложение: темы, музыка, слоты, док приложений и плеер с синхронным текстом",
  "author": {
    "name": "miklm",
    "email": "186920249+Fedor-redhat@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fedor-redhat/web_Cheliksy.git"
  },
  "homepage": "https://github.com/Fedor-redhat/web_Cheliksy#readme",
  "bugs": {
    "url": "https://github.com/Fedor-redhat/web_Cheliksy/issues"
  },
  "license": "MIT",
  "main": "main.js",
  "desktopName": "veb-prilozhenie.desktop",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "ru.miklm.vebprilozhenie",
    "productName": "Veb Prilozhenie",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "web/**/*"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VebPrilozhenie-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "executableName": "veb-prilozhenie",
      "syncDesktopName": true,
      "synopsis": "Музыка, синхронный текст, визуализация и системный монитор",
      "description": "Личный десктоп на Electron: темы и свои обои, музыка с синхронным текстом, визуализация, слоты, док и системный монитор.",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VebPrilozhenie-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Веб-приложение",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "VebPrilozhenie-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "music-metadata": "^7.14.0",
    "systeminformation": "^5.27.14"
  }
}
